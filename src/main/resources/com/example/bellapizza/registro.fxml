<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bellapizza.RegistroController">
   <children>
      <Label layoutX="114.0" layoutY="27.0" text="Registro">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></Label>
      <Label layoutX="69.0" layoutY="43.0" text="Crea tu cuenta de cliente  ">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></Label>
      <TextField fx:id="txtNombre" layoutX="63.0" layoutY="94.0" promptText="Nombre y apellidos">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></TextField>
      <TextField fx:id="txtUsuario" layoutX="63.0" layoutY="136.0" promptText="Usuario">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></TextField>
      <TextField fx:id="txtCorreo" layoutX="63.0" layoutY="174.0" promptText="Correo electrónico">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></TextField>
      <TextField fx:id="txtContrasena" layoutX="63.0" layoutY="215.0" promptText="Contraseña">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></TextField>
      <TextField fx:id="txtConfirmar" layoutX="63.0" layoutY="262.0" promptText="Confirmar contraseña">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></TextField>
      <Button layoutX="63.0" layoutY="299.0" mnemonicParsing="false" onAction="#registrar" prefHeight="25.0" prefWidth="149.0" text="Registrarse">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></Button>
      <Button layoutX="92.0" layoutY="342.0" mnemonicParsing="false" onAction="#atras" text="Volver al login">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></Button>
      <ImageView fitHeight="424.0" fitWidth="400.0" layoutX="349.0" layoutY="-3.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/registro.jpg" />
         </image></ImageView>
      <Label fx:id="labelStatus" layoutX="10.0" layoutY="71.0" prefHeight="18.0" prefWidth="304.0" textFill="#18b10a">
         <font>
            <Font name="Inter Regular" size="12.0" />
         </font></Label>
   </children>
</AnchorPane>
